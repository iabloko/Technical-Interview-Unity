{
  "name": "technical-interview-unity",
  "compatibility_date": "2026-09-26",
  // Отдельные адреса версий (<version>-technical-interview-unity...) не используются
  "preview_urls": false,
  // Скрипт выполняется только для mp3 (поддержка Range), остальное отдаётся статикой
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*.mp3"]
  }
}
